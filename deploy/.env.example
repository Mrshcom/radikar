# Used by Docker Compose and Caddy.
APP_DOMAIN=radikar.example.com
NEXT_PUBLIC_API_BASE_URL=https://radikar.example.com

# PostgreSQL. Use a long URL-safe password because it is interpolated into DATABASE_URL.
POSTGRES_DB=radikar
POSTGRES_USER=radikar
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
DATABASE_MAX_CONNECTIONS=10
MAX_UPLOAD_SIZE_MB=8

# API and authentication.
CORS_ORIGINS=https://radikar.example.com
API_PUBLIC_URL=https://radikar.example.com
WEB_APP_URL=https://radikar.example.com
LOG_LEVEL=info
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=180
ALLOW_FIRST_USER_SUPERADMIN=false
# Set only for the first controlled superadmin bootstrap, then remove it.
# BOOTSTRAP_SUPERADMIN_PHONE=09123456789

# Production SMS webhook. Required when NODE_ENV=production.
# SMS.ir credentials are server-only. Never prefix them with NEXT_PUBLIC_.
SMSIR_USERNAME=replace-me
SMSIR_API_KEY=replace-me
SMSIR_LINE_NUMBER=3000xxxxxxxx
SMSIR_BASE_URL=https://api.sms.ir/v1
SMSIR_TIMEOUT_MS=8000
# Optional legacy fallback when SMS.ir is not configured:
# OTP_WEBHOOK_URL=https://sms-provider.example/send
# OTP_WEBHOOK_TOKEN=replace-me

# Google login. The callback must exactly match the authorized redirect URI.
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://radikar.example.com/api/auth/google/callback

# Zarinpal production.
ZARINPAL_BASE_URL=https://api.zarinpal.com
ZARINPAL_MERCHANT_ID=replace-with-real-merchant-uuid
APIFY_API_TOKEN=replace-with-apify-api-token
APIFY_LINKEDIN_ACTOR_ID=data-slayer~linkedin-profile-scraper
APIFY_LINKEDIN_JOBS_ACTOR_ID=cheap_scraper~linkedin-job-scraper
JOB_POOL_ENABLED=false
JOB_POOL_DAILY_LIMIT=500
JOB_POOL_INTERVAL_HOURS=24
JOB_POOL_LOCATIONS=
JOB_POOL_PUBLISHED_AT=r86400
JOB_POOL_COST_PER_1000_USD_MICROS=700000
JOB_POOL_ACTOR_START_COST_USD_MICROS=20000

# GapGPT.
GAPGPT_API_KEY=replace-me
GAPGPT_MODEL=gapgpt-qwen-3.6
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
LLM_PROVIDER=gapgpt

# Writing tasks currently use the local DeepSeek-compatible proxy.
LLM_WRITE_PROVIDER=freeDeepseekAPI
LLM_WRITE_MODEL=deepseek-reasoner
FREE_DEEPSEEK_PORT=9655
FREE_DEEPSEEK_BASE_URL=http://host.docker.internal:9655/v1

# Alternatively, configure a separate OpenAI-compatible writing provider.
# On serverless platforms, GapGPT can be used for writing as well:
# LLM_WRITE_PROVIDER=gapgpt
# LLM_WRITE_MODEL=gapgpt-qwen-3.6
#
# LLM_WRITE_PROVIDER=openai-compatible
# LLM_WRITE_MODEL=your-writing-model
# LLM_WRITE_API_KEY=replace-me
# LLM_WRITE_BASE_URL=https://provider.example/v1
