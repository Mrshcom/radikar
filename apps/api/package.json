{
  "name": "@radicar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit",
    "vercel-build": "npm run db:migrate --workspace @radicar/database && npm run build && ../../node_modules/.bin/esbuild src/app.ts --bundle --platform=node --format=esm --target=node22 --banner:js=\"import Fastify from 'fastify'; void Fastify;\" --outfile=src/app.mjs && mv src/app.ts src/_app.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@radicar/ai": "*",
    "@radicar/config": "*",
    "@radicar/database": "*",
    "@radicar/shared-types": "*",
    "@radicar/validators": "*",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.6.2",
    "mammoth": "^1.12.0",
    "tsx": "^4.20.6",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
