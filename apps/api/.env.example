API_HOST=127.0.0.1
API_PORT=3162
CORS_ORIGINS=http://localhost:3161
DATABASE_URL=postgresql://radikar:radikar@127.0.0.1:5433/radikar
MAX_UPLOAD_SIZE_MB=8
DATABASE_MAX_CONNECTIONS=10
LOG_LEVEL=info

# Generate a long random secret before production.
AUTH_SECRET=development-only-secret-change-before-production
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=180
# Temporary in every environment: generate a real OTP challenge without calling the SMS provider.
# Later set OTP_DELIVERY_MODE=provider and OTP_LOG_REVERSED_CODE=false to use Kavenegar only.
OTP_DELIVERY_MODE=console
# This exposes OTPs to unauthenticated clients. Required while delivery mode is console.
OTP_LOG_REVERSED_CODE=true
ALLOW_FIRST_USER_SUPERADMIN=true
# BOOTSTRAP_SUPERADMIN_PHONE=09123456789

# Provider settings are optional in console mode and required in provider mode. Keep them server-side only.
# Current provider: kavenegar. Its approved template must include %token.
OTP_PROVIDER=kavenegar
OTP_PROVIDER_API_KEY=replace-me
OTP_PROVIDER_TEMPLATE=radikarlogin
OTP_PROVIDER_BASE_URL=https://api.kavenegar.com/v1
OTP_PROVIDER_TIMEOUT_MS=8000

# Google login (optional). Register this callback in Google Cloud Console:
# http://localhost:3161/api/auth/google/callback
# GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3161/api/auth/google/callback

API_PUBLIC_URL=http://localhost:3162
WEB_APP_URL=http://localhost:3161
# Set PAYMENT_PROVIDER=abropay and provide its server-side secret to switch new checkouts.
# Old Zarinpal orders remain verifiable through their stored provider.
PAYMENT_PROVIDER=zarinpal
PAYMENT_PROVIDER_ENVIRONMENT=sandbox
PAYMENT_PROVIDER_BASE_URL=https://pay.abrotech.ir
# PAYMENT_PROVIDER_SECRET_KEY=sk_test_replace-me
# Local test with a live key: set ENVIRONMENT=live, API_PUBLIC_URL to a public HTTPS tunnel to localhost:3162,
# and keep WEB_APP_URL=http://localhost:3161. In production both URLs must be public HTTPS.
# Legacy Zarinpal Sandbox (the sandbox accepts any valid UUID as merchant id)
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
ZARINPAL_MERCHANT_ID=00000000-0000-4000-8000-000000000000
APIFY_API_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=data-slayer~linkedin-profile-scraper
# Centralized job pool: one grouped daily run, hard-capped at 500 results.
APIFY_LINKEDIN_JOBS_ACTOR_ID=cheap_scraper~linkedin-job-scraper
JOB_POOL_ENABLED=false
JOB_POOL_DAILY_LIMIT=500
JOB_POOL_INTERVAL_HOURS=24
# Comma-separated locations. Leave empty for broad/global results.
JOB_POOL_LOCATIONS=
JOB_POOL_PUBLISHED_AT=r86400
# Cost guardrails in USD micros: $0.70 / 1,000 results and $0.02 / run.
JOB_POOL_COST_PER_1000_USD_MICROS=700000
JOB_POOL_ACTOR_START_COST_USD_MICROS=20000

# AI providers
# Set LLM_PROVIDER=agent for Abro AI agents. The interviewer handles questions and reports;
# the resume ranker handles employer screening. Keep the key on the API server only.
# LLM_PROVIDER=agent
# LLM_BASE_URL=https://api.dev.ai.abrodev.ir
# LLM_API_KEY=client-id.client-secret
# LLM_AGENT_RESUME_RANKER=radikar_resume_ranker
# LLM_AGENT_INTERVIEWER=test_interview
# LLM_TIMEOUT_MS=90000
# Other AI features continue using LLM_GENERAL_PROVIDER while agent mode is enabled.
# LLM_GENERAL_PROVIDER=gapgpt
# LLM_GENERAL_MODEL=your-model-name
# LLM_GENERAL_API_KEY=replace-me
# LLM_GENERAL_BASE_URL=https://provider.example/v1
# Otherwise use LLM_PROVIDER=openai-compatible with the generic settings below.
# LLM_MODEL=your-model-name
# LLM_PROVIDER=openai-compatible
# LLM_INPUT_PRICE_PER_MILLION_USD=0
# LLM_OUTPUT_PRICE_PER_MILLION_USD=0
# LLM_WRITE_PROVIDER=openai-compatible
# LLM_WRITE_MODEL=your-writing-model
# LLM_WRITE_API_KEY=replace-me
# LLM_WRITE_BASE_URL=https://provider.example/v1
# LLM_WRITE_INPUT_PRICE_PER_MILLION_USD=0
# LLM_WRITE_OUTPUT_PRICE_PER_MILLION_USD=0
# FREE_DEEPSEEK_PORT=9655
# GapGPT (OpenAI Responses API)
# GAPGPT_API_KEY=replace-me
# GAPGPT_MODEL=gapgpt-qwen-3.6
# GAPGPT_BASE_URL=https://api.gapgpt.app/v1
