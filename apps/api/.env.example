API_HOST=127.0.0.1
API_PORT=3162
CORS_ORIGINS=http://localhost:3161
DATABASE_URL=postgresql://radicar:radicar@127.0.0.1:5433/radicar
DATABASE_MAX_CONNECTIONS=10
LOG_LEVEL=info

# Generate a long random secret before production.
AUTH_SECRET=development-only-secret-change-before-production
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=180
EXPOSE_DEVELOPMENT_OTP=true
ALLOW_FIRST_USER_SUPERADMIN=true
# BOOTSTRAP_SUPERADMIN_PHONE=09123456789
# OTP_WEBHOOK_URL=https://sms-provider.example/send
# OTP_WEBHOOK_TOKEN=replace-me

# Zarinpal Sandbox (the sandbox accepts any valid UUID as merchant id)
API_PUBLIC_URL=http://127.0.0.1:3162
WEB_APP_URL=http://localhost:3161
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
ZARINPAL_MERCHANT_ID=00000000-0000-4000-8000-000000000000

# AI providers
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=your-model-name
# LLM_API_KEY=replace-me
# LLM_BASE_URL=https://provider.example/v1
# LLM_WRITE_PROVIDER=openai-compatible
# LLM_WRITE_MODEL=your-writing-model
# LLM_WRITE_API_KEY=replace-me
# LLM_WRITE_BASE_URL=https://provider.example/v1
