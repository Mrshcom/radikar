API_HOST=127.0.0.1
API_PORT=3162
CORS_ORIGINS=http://localhost:3161
DATABASE_URL=postgresql://radikar:radikar@127.0.0.1:5433/radikar
MAX_UPLOAD_SIZE_MB=8
DATABASE_MAX_CONNECTIONS=10
LOG_LEVEL=info

# Generate a long random secret before production.
AUTH_SECRET=development-only-secret-change-before-production
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=180
ALLOW_FIRST_USER_SUPERADMIN=true
# BOOTSTRAP_SUPERADMIN_PHONE=09123456789
# OTP_WEBHOOK_URL=https://sms-provider.example/send
# OTP_WEBHOOK_TOKEN=replace-me

# SMS.ir (preferred OTP provider). Keep these values server-side only.
# SMSIR_USERNAME=replace-me
# SMSIR_API_KEY=replace-me
# SMSIR_LINE_NUMBER=3000xxxxxxxx
SMSIR_BASE_URL=https://api.sms.ir/v1
SMSIR_TIMEOUT_MS=8000

# Google login (optional). Register this callback in Google Cloud Console:
# http://localhost:3161/api/auth/google/callback
# GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3161/api/auth/google/callback

# Zarinpal Sandbox (the sandbox accepts any valid UUID as merchant id)
API_PUBLIC_URL=http://localhost:3162
WEB_APP_URL=http://localhost:3161
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
ZARINPAL_MERCHANT_ID=00000000-0000-4000-8000-000000000000
APIFY_API_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=data-slayer~linkedin-profile-scraper
# Centralized job pool: one grouped daily run, hard-capped at 500 results.
APIFY_LINKEDIN_JOBS_ACTOR_ID=cheap_scraper~linkedin-job-scraper
JOB_POOL_ENABLED=false
JOB_POOL_DAILY_LIMIT=500
JOB_POOL_INTERVAL_HOURS=24
# Comma-separated locations. Leave empty for broad/global results.
JOB_POOL_LOCATIONS=
JOB_POOL_PUBLISHED_AT=r86400
# Cost guardrails in USD micros: $0.70 / 1,000 results and $0.02 / run.
JOB_POOL_COST_PER_1000_USD_MICROS=700000
JOB_POOL_ACTOR_START_COST_USD_MICROS=20000

# AI providers
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=your-model-name
# LLM_API_KEY=replace-me
# LLM_BASE_URL=https://provider.example/v1
# LLM_INPUT_PRICE_PER_MILLION_USD=0
# LLM_OUTPUT_PRICE_PER_MILLION_USD=0
# LLM_WRITE_PROVIDER=openai-compatible
# LLM_WRITE_MODEL=your-writing-model
# LLM_WRITE_API_KEY=replace-me
# LLM_WRITE_BASE_URL=https://provider.example/v1
# LLM_WRITE_INPUT_PRICE_PER_MILLION_USD=0
# LLM_WRITE_OUTPUT_PRICE_PER_MILLION_USD=0
# FREE_DEEPSEEK_PORT=9655
# GapGPT (OpenAI Responses API)
# GAPGPT_API_KEY=replace-me
# GAPGPT_MODEL=gapgpt-qwen-3.6
# GAPGPT_BASE_URL=https://api.gapgpt.app/v1
